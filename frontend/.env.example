# Frontend - Animales 3D Web

# URL de la API, incluyendo el prefijo /api.
# Local:      http://localhost:3333/api
# Producción: https://mascotas3d-api.onrender.com/api
#
# Es NEXT_PUBLIC_* porque el navegador la necesita: nunca pongas secretos aquí,
# todo lo NEXT_PUBLIC_ viaja al cliente en texto plano.
NEXT_PUBLIC_API_URL=http://localhost:3333/api
