# Backend - Animales 3D API

# Configuración de Base de Datos PostgreSQL
# LOCAL DEVELOPMENT
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/animales_3d_dev?schema=public"

# JWT
JWT_SECRET="tu-clave-secreta-super-segura-cambia-en-produccion"
JWT_EXPIRATION="24h"

# Servidor
PORT=3333
NODE_ENV=development
API_URL=http://localhost:3333

# CORS
CORS_ORIGIN=http://localhost:3000

# Almacenamiento de archivos
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# Cloudinary: alojamiento de las fotografías de mascotas.
# El API secret vive SOLO aquí, nunca en el frontend ni en una variable
# NEXT_PUBLIC_*. La subida pasa por el backend justamente por esto.
# Sin estas tres variables la subida de fotos queda deshabilitada.
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret
CLOUDINARY_FOLDER=mascotas3d/animales

# Email (Opcional para futuro)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
